# Storefront API
# Base URL of the backend serving /connector/api/ecommerce/* (leave empty for same-origin)
VITE_API_BASE_URL=

# Required — the business id passed to every storefront endpoint
VITE_BUSINESS_ID=

# Public origin of this website — used for canonical/og URLs in index.html (%VITE_SITE_URL%)
# Set to the production domain, e.g. https://legendprotek.com
VITE_SITE_URL=

# Careers form — Google Apps Script web-app URL (see google-apps-script/Code.gs).
# When set, applications are emailed directly from your Gmail with the CV attached.
VITE_EMAIL_RELAY_URL=
